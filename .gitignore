# Keep the current app, not local experiments, environments, logs or recordings.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/COLLABORATION.md
!/requirements.txt
!/requirements-hosting.txt
!/.python-version
!/render.yaml
!/web_app.py
!/prepare_hosting.py
!/server.py
!/profile_service.py
!/remote_profile.py
!/extract_profiles.py
!/build_demo.py
!/ray_model.py
!/atmospheric_layers.py
!/build_atmosphere_overlay.py
!/launch-sound-lab.ps1
!/Open Sound Lab.cmd
!/dist/
!/docs/
/docs/*
!/docs/media/
!/data/
/data/*
!/data/vertical-grid.json
!/data/profiles.json
!/data/gcpy-LICENSE.txt
!/data/hosted-fields.npz
!/data/hosted-fields.json
/dist/audio/
/dist/assets/*.mp4
/dist/assets/*.webm
/dist/assets/*.glb
/dist/audio-data.js
